# 이 파일을 복사해서 .env 를 만들고 값을 채우세요.  (copy .env.example .env)
# .env 는 .gitignore 에 등록되어 GitHub 에 올라가지 않습니다.

# Google Gemini API Key  (https://aistudio.google.com/api-keys)
GEMINI_API_KEY=
# 비워두면 gemini-flash-latest 사용
GEMINI_MODEL=

# Gmail IMAP Settings
# 구글 계정 보안 > 2단계 인증 > '앱 비밀번호(App Password)'에서 발급받은 16자리 암호
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_LABEL=News
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_IMAP_PORT=993

# Newspaper Metadata
NEWSPAPER_TITLE=My Tech Daily
PUBLISHER_NAME=Publisher
EDITION_NAME=My 에디션
# 발행 시각(시)과 발행 요일. 수집 구간 = 직전 발행일 N시 ~ 발행일 N시
# PUBLISH_DAYS 예) mon-fri(기본, 월요일 호는 금 08:00~월 08:00 수집) / daily / mon,wed,fri
PUBLISH_HOUR=8
PUBLISH_DAYS=mon-fri

# 지면 꾸미기 (선택)
TAGLINE=AI 편집장이 고른 오늘의 테크 뉴스
# 제호 옆 날씨 (Open-Meteo, 키 불필요). 끄려면 false
WEATHER_ENABLED=true
WEATHER_CITY=서울
WEATHER_LAT=37.5665
WEATHER_LON=126.9780
# GitHub Pages 주소 (비우면 git origin 에서 자동 추정) — RSS·QR·공유 미리보기에 사용
SITE_URL=

# (선택) 뉴스레터 메일 발송 — 기본 꺼짐. 받는 사람을 비우면 GMAIL_USER 본인
NEWSLETTER_ENABLED=false
NEWSLETTER_TO=
