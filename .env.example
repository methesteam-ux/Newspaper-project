# 이 파일을 복사해서 .env 를 만들고 값을 채우세요.  (copy .env.example .env)
# .env 는 .gitignore 에 등록되어 GitHub 에 올라가지 않습니다.

# Google Gemini API Key  (https://aistudio.google.com/api-keys)
GEMINI_API_KEY=
# 비워두면 gemini-flash-latest 사용
GEMINI_MODEL=

# Gmail IMAP Settings
# 구글 계정 보안 > 2단계 인증 > '앱 비밀번호(App Password)'에서 발급받은 16자리 암호
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_LABEL=News
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_IMAP_PORT=993

# Newspaper Metadata
NEWSPAPER_TITLE=My Tech Daily
PUBLISHER_NAME=Publisher
EDITION_NAME=My 에디션
# 수집 기준 시각 (전날 N시 ~ 당일 N시)
PUBLISH_HOUR=8
